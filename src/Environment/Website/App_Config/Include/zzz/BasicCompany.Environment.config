<?xml version="1.0"?>
<!--
  Per-environment settings for the Basic Company example.
  This is the only file you should need to edit when deploying to another Sitecore XP 10.3 instance.
  It lives in the "zzz" folder so it loads after the Foundation / Feature / Project configs it overrides.
-->
<configuration xmlns:patch="http://www.sitecore.net/xmlconfig/"
               xmlns:role="http://www.sitecore.net/xmlconfig/role/"
               xmlns:set="http://www.sitecore.net/xmlconfig/set/">
  <sitecore>

    <!--
      Host name the Basic Company site answers on. It needs a matching IIS binding and hosts file entry
      (deploy.ps1 -HostName adds both). Several names can be separated with |.
    -->
    <sites>
      <site name="basic-company">
        <patch:attribute name="hostName">basiccompany.local</patch:attribute>
      </site>
    </sites>

    <!--
      Folder that holds the serialized items (.yml). The default "~/App_Data/unicorn" is where the build puts them.
      On a developer machine you can point it at the source tree instead, so "Reserialize" writes back to git:
    -->
    <!--
    <sc.variable name="sourceFolder">
      <patch:attribute name="value">D:\Project\Helix.Examples-master\examples\helix-basic-unicorn\src</patch:attribute>
    </sc.variable>
    -->

    <unicorn role:require="Standalone or ContentManagement">
      <!--
        Transparent sync reads items straight from the .yml files without writing them to the database.
        Keep it off for a normal deployment: items are written to the master database by a Unicorn sync.
      -->
      <defaults>
        <dataProviderConfiguration set:enableTransparentSync="false" />
      </defaults>

      <!--
        Uncomment and set a long random value (64+ characters) to allow scripted syncs
        (deploy.ps1 -Sync). Leave it commented to sync only from /unicorn.aspx.
      -->
      <!--
      <authenticationProvider>
        <SharedSecret>CHANGE-ME-TO-A-LONG-RANDOM-SECRET</SharedSecret>
      </authenticationProvider>
      -->
    </unicorn>

  </sitecore>
</configuration>
